{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "ES2022"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noImplicitAny": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "allowJs": false,
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./*"
      ],
      "@signalai/types": [
        "../packages/types/src/index.ts"
      ],
      "@signalai/ui": [
        "../packages/ui/src/index.tsx"
      ],
      "@signalai/utils": [
        "../packages/utils/src/index.ts"
      ],
      "react": [
        "./node_modules/react"
      ],
      "react/*": [
        "./node_modules/react/*"
      ],
      "react-dom": [
        "./node_modules/react-dom"
      ],
      "react-dom/*": [
        "./node_modules/react-dom/*"
      ]
    },
    "ignoreDeprecations": "6.0"
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
