{
  "info": {
    "name": "SignalAI – Upstox API",
    "description": "Complete SignalAI API: auth, broker, market data, ORB strategy, charts, orders, and records.\n\nSet collection variable `base_url` to your API host (default: http://localhost:8003/api/v1).\nSet `api_root` to the root host (default: http://localhost:8003).\nSet `auth_token` to Basic auth value: ZWRyYW86Y2hpcnUxMjM=",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url",   "value": "http://localhost:8003/api/v1" },
    { "key": "api_root",   "value": "http://localhost:8003" },
    { "key": "auth_token", "value": "ZWRyYW86Y2hpcnUxMjM=" }
  ],
  "auth": {
    "type": "basic",
    "basic": [
      { "key": "username", "value": "edrao",  "type": "string" },
      { "key": "password", "value": "chiru123", "type": "string" }
    ]
  },
  "item": [
    {
      "name": "🏥 Meta",
      "item": [
        {
          "name": "Root",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{api_root}}/",
              "host": ["{{api_root}}"],
              "path": [""]
            },
            "description": "Returns API name, version, live trading flag, and disclaimer."
          }
        },
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{api_root}}/health",
              "host": ["{{api_root}}"],
              "path": ["health"]
            },
            "description": "Returns { ok, version, uptime_seconds, environment, request_id }."
          }
        }
      ]
    },
    {
      "name": "🔐 Auth",
      "item": [
        {
          "name": "Login",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"edrao\",\n  \"password\": \"chiru123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": ["{{base_url}}"],
              "path": ["auth", "login"]
            },
            "description": "Validate credentials. Returns { ok: true, user_id }.\nNo JWT issued — subsequent requests use HTTP Basic auth."
          }
        },
        {
          "name": "Current User (me)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/auth/me",
              "host": ["{{base_url}}"],
              "path": ["auth", "me"]
            },
            "description": "Returns the currently authenticated user info."
          }
        }
      ]
    },
    {
      "name": "🔗 Broker – Upstox Auth",
      "item": [
        {
          "name": "Get Upstox Login URL",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/broker/upstox/login-url",
              "host": ["{{base_url}}"],
              "path": ["broker", "upstox", "login-url"]
            },
            "description": "Returns the Upstox OAuth authorization URL. Open in browser to get the auth code."
          }
        },
        {
          "name": "Connect Upstox (Exchange OAuth Code)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"<paste_oauth_code_from_redirect_url_here>\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/broker/upstox/connect",
              "host": ["{{base_url}}"],
              "path": ["broker", "upstox", "connect"]
            },
            "description": "Exchange OAuth authorization code for access token. Token is stored in Redis and used by all subsequent Upstox endpoints."
          }
        },
        {
          "name": "Upstox Connection Status",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/broker/upstox/status",
              "host": ["{{base_url}}"],
              "path": ["broker", "upstox", "status"]
            },
            "description": "Check if an Upstox access token is stored in Redis.\nReturns: { connected: true/false }"
          }
        },
        {
          "name": "Disconnect Upstox",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/broker/disconnect",
              "host": ["{{base_url}}"],
              "path": ["broker", "disconnect"]
            },
            "description": "Removes the Upstox token from Redis."
          }
        }
      ]
    },
    {
      "name": "📊 Historical Candles",
      "item": [
        {
          "name": "Get Historical Candles by ISIN",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/upstox/historical-candle?exchange=NSE_EQ&isin=INE002A01018&from_date=2025-01-01&to_date=2025-01-31&interval_type=minutes&interval_value=5",
              "host": ["{{base_url}}"],
              "path": ["upstox", "historical-candle"],
              "query": [
                { "key": "exchange",       "value": "NSE_EQ",       "description": "NSE_EQ | BSE_EQ | NSE_FO | BSE_FO | MCX_FO" },
                { "key": "isin",           "value": "INE002A01018", "description": "Instrument ISIN (RELIANCE)" },
                { "key": "from_date",      "value": "2025-01-01",   "description": "YYYY-MM-DD" },
                { "key": "to_date",        "value": "2025-01-31",   "description": "YYYY-MM-DD" },
                { "key": "interval_type",  "value": "minutes",      "description": "minutes | hours | days | weeks | months" },
                { "key": "interval_value", "value": "5",            "description": "1, 5, 15, 25, 75, 125" }
              ]
            },
            "description": "Fetch OHLCV candles using a specific ISIN code.\n\nCommon ISINs:\n- RELIANCE: INE002A01018\n- TCS: INE467B01029\n- INFY: INE009A01021\n- HDFCBANK: INE040A01034\n- ICICIBANK: INE090A01021"
          }
        },
        {
          "name": "Get Historical Candles by Symbol",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/upstox/historical-candle-by-symbol?symbol=RELIANCE&exchange=NSE_EQ&from_date=2025-01-01&to_date=2025-01-31&interval_type=minutes&interval_value=5",
              "host": ["{{base_url}}"],
              "path": ["upstox", "historical-candle-by-symbol"],
              "query": [
                { "key": "symbol",         "value": "RELIANCE",  "description": "NSE stock symbol" },
                { "key": "exchange",       "value": "NSE_EQ",    "description": "NSE_EQ | BSE_EQ | NSE_FO | BSE_FO | MCX_FO" },
                { "key": "from_date",      "value": "2025-01-01","description": "YYYY-MM-DD" },
                { "key": "to_date",        "value": "2025-01-31","description": "YYYY-MM-DD" },
                { "key": "interval_type",  "value": "minutes",   "description": "minutes | hours | days | weeks | months" },
                { "key": "interval_value", "value": "5",         "description": "1, 5, 15, 25, 75, 125" }
              ]
            },
            "description": "Fetch OHLCV candles using stock symbol. ISIN is resolved internally from the NIFTY500 instrument map."
          }
        },
        {
          "name": "Get Daily Candles (1 Year)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/upstox/historical-candle-by-symbol?symbol=TCS&exchange=NSE_EQ&from_date=2024-01-01&to_date=2024-12-31&interval_type=days&interval_value=1",
              "host": ["{{base_url}}"],
              "path": ["upstox", "historical-candle-by-symbol"],
              "query": [
                { "key": "symbol",         "value": "TCS" },
                { "key": "exchange",       "value": "NSE_EQ" },
                { "key": "from_date",      "value": "2024-01-01" },
                { "key": "to_date",        "value": "2024-12-31" },
                { "key": "interval_type",  "value": "days" },
                { "key": "interval_value", "value": "1" }
              ]
            }
          }
        },
        {
          "name": "Get 15min Candles",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/upstox/historical-candle-by-symbol?symbol=INFY&exchange=NSE_EQ&from_date=2025-01-01&to_date=2025-03-31&interval_type=minutes&interval_value=15",
              "host": ["{{base_url}}"],
              "path": ["upstox", "historical-candle-by-symbol"],
              "query": [
                { "key": "symbol",         "value": "INFY" },
                { "key": "exchange",       "value": "NSE_EQ" },
                { "key": "from_date",      "value": "2025-01-01" },
                { "key": "to_date",        "value": "2025-03-31" },
                { "key": "interval_type",  "value": "minutes" },
                { "key": "interval_value", "value": "15" }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "⚡ Intraday Candles",
      "item": [
        {
          "name": "Get Intraday Candle (Single Symbol)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/upstox/intraday-candle?symbol=RELIANCE&exchange=NSE_EQ&interval_type=minutes&interval_value=5",
              "host": ["{{base_url}}"],
              "path": ["upstox", "intraday-candle"],
              "query": [
                { "key": "symbol",         "value": "RELIANCE",  "description": "NSE trading symbol" },
                { "key": "exchange",       "value": "NSE_EQ",    "description": "NSE_EQ | BSE_EQ | NSE_FO | BSE_FO | MCX_FO" },
                { "key": "interval_type",  "value": "minutes",   "description": "minutes | hours | days" },
                { "key": "interval_value", "value": "5",         "description": "e.g. 1, 5, 15" }
              ]
            },
            "description": "Fetch today's intraday OHLCV candles for a single symbol. No data is written to the database."
          }
        },
        {
          "name": "Get Intraday Candles (Multiple Symbols)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"symbols\": [\"RELIANCE\", \"TCS\", \"INFY\"],\n  \"exchange\": \"NSE_EQ\",\n  \"interval_type\": \"minutes\",\n  \"interval_value\": \"5\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/upstox/intraday-candles/multi",
              "host": ["{{base_url}}"],
              "path": ["upstox", "intraday-candles", "multi"]
            },
            "description": "Fetch today's intraday OHLCV candles for multiple symbols in one call. No data is written to the database. Failures for individual symbols are captured per-symbol."
          }
        }
      ]
    },
    {
      "name": "📥 Bulk Data Import",
      "item": [
        {
          "name": "Historical Data Import (Multiple Symbols)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"stock_codes\": [\"RELIANCE\", \"TCS\", \"INFY\", \"HDFCBANK\", \"ICICIBANK\"],\n  \"exchange\": \"NSE_EQ\",\n  \"from_date\": \"2024-01-01\",\n  \"to_date\": \"2024-12-31\",\n  \"interval_type\": \"minutes\",\n  \"interval_value\": \"5\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/upstox/historical-data-import",
              "host": ["{{base_url}}"],
              "path": ["upstox", "historical-data-import"]
            },
            "description": "Bulk import historical OHLCV data for multiple symbols into the candle_data DB table.\n\nDate ranges are auto-split to respect Upstox limits:\n- minutes (1-15): 1 month per chunk\n- minutes (>15) / hours: 3 months per chunk\n- days/weeks/months: no splitting\n\ninterval_value options: 1, 5, 15, 25, 75, 125 (minutes) | 1, 2, 4 (hours) | 1 (days/weeks/months)"
          }
        },
        {
          "name": "Historical Import – 5min (Last 3 Months)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"stock_codes\": [\"RELIANCE\", \"TCS\", \"INFY\"],\n  \"exchange\": \"NSE_EQ\",\n  \"from_date\": \"2025-03-01\",\n  \"to_date\": \"2025-06-14\",\n  \"interval_type\": \"minutes\",\n  \"interval_value\": \"5\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/upstox/historical-data-import",
              "host": ["{{base_url}}"],
              "path": ["upstox", "historical-data-import"]
            }
          }
        },
        {
          "name": "Historical Import – Daily (1 Year)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"stock_codes\": [\"RELIANCE\", \"TCS\", \"INFY\", \"HDFCBANK\", \"ICICIBANK\", \"WIPRO\", \"AXISBANK\", \"SBIN\"],\n  \"exchange\": \"NSE_EQ\",\n  \"from_date\": \"2024-01-01\",\n  \"to_date\": \"2024-12-31\",\n  \"interval_type\": \"days\",\n  \"interval_value\": \"1\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/upstox/historical-data-import",
              "host": ["{{base_url}}"],
              "path": ["upstox", "historical-data-import"]
            }
          }
        },
        {
          "name": "Intraday Data Import (Today)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"stock_codes\": [\"RELIANCE\", \"TCS\", \"INFY\"],\n  \"exchange\": \"NSE_EQ\",\n  \"interval_type\": \"minutes\",\n  \"interval_value\": \"5\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/upstox/intraday-data-import",
              "host": ["{{base_url}}"],
              "path": ["upstox", "intraday-data-import"]
            },
            "description": "Import today's live intraday candles into DB.\nOnly supports interval_type: minutes | hours."
          }
        }
      ]
    },
    {
      "name": "🗺️ Instruments",
      "item": [
        {
          "name": "List Index Instruments",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/instruments",
              "host": ["{{base_url}}"],
              "path": ["instruments"]
            },
            "description": "Returns instrument keys for NIFTY, BANKNIFTY, FINNIFTY, SENSEX."
          }
        },
        {
          "name": "List Equity Stocks",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/equity/stocks",
              "host": ["{{base_url}}"],
              "path": ["equity", "stocks"]
            },
            "description": "Returns up to 750 NSE EQ stocks with symbol, name, and sector from the DB."
          }
        },
        {
          "name": "Lookup Instrument ISIN",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/upstox/instruments/lookup?symbol=RELIANCE",
              "host": ["{{base_url}}"],
              "path": ["upstox", "instruments", "lookup"],
              "query": [
                { "key": "symbol", "value": "RELIANCE", "description": "NSE trading symbol e.g. 360ONE" }
              ]
            },
            "description": "Look up the ISIN for a given NSE symbol using the live instrument map."
          }
        },
        {
          "name": "Refresh Instrument Map",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/upstox/instruments/refresh",
              "host": ["{{base_url}}"],
              "path": ["upstox", "instruments", "refresh"]
            },
            "description": "Force-refresh the NSE instrument map by downloading the latest Upstox CSV. Returns { status, symbols_loaded }."
          }
        }
      ]
    },
    {
      "name": "📈 Charts",
      "item": [
        {
          "name": "List Chart Symbols",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/charts/symbols",
              "host": ["{{base_url}}"],
              "path": ["charts", "symbols"]
            },
            "description": "Returns all NSE EQ symbols from the nse_eq_symbols table (symbol, name, sector)."
          }
        },
        {
          "name": "Get Candles",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/charts/candles?symbol=RELIANCE&timeframe=1D&from=2025-01-01&to=2025-03-31&limit=500",
              "host": ["{{base_url}}"],
              "path": ["charts", "candles"],
              "query": [
                { "key": "symbol",    "value": "RELIANCE" },
                { "key": "timeframe", "value": "1D", "description": "1m | 5m | 15m | 30m | 1h | 1D | 1W | 1M" },
                { "key": "from",      "value": "2025-01-01", "description": "YYYY-MM-DD" },
                { "key": "to",        "value": "2025-03-31", "description": "YYYY-MM-DD" },
                { "key": "limit",     "value": "500", "description": "1–2000" }
              ]
            },
            "description": "Fetch OHLCV candles. Primary source: stock_data_* DB tables. Falls back to Upstox live API if a connected broker token is available."
          }
        },
        {
          "name": "Get Symbol Summary",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/charts/summary?symbol=RELIANCE",
              "host": ["{{base_url}}"],
              "path": ["charts", "summary"],
              "query": [
                { "key": "symbol", "value": "RELIANCE" }
              ]
            },
            "description": "Returns latest price, 52-week high/low, average volume from stock_data_daily.\nFalls back to Upstox if a broker token is available."
          }
        },
        {
          "name": "Indicator Backtest (Bulk)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"symbols\": [\"RELIANCE\", \"TCS\", \"INFY\"],\n  \"timeframe\": \"1D\",\n  \"from_date\": \"2024-01-01\",\n  \"to_date\": \"2024-12-31\",\n  \"conditions\": [\n    { \"type\": \"sma_crossover\", \"fast\": 10, \"slow\": 50 }\n  ],\n  \"action\": \"BUY\",\n  \"sl_pct\": 2.0,\n  \"tp_pct\": 4.0,\n  \"tsl_pct\": 0.0,\n  \"qty\": 100,\n  \"max_hold_days\": 30\n}"
            },
            "url": {
              "raw": "{{base_url}}/charts/indicator-backtest",
              "host": ["{{base_url}}"],
              "path": ["charts", "indicator-backtest"]
            },
            "description": "Run a technical-indicator strategy backtest on real DB OHLCV data for multiple symbols.\nReturns per-symbol results: trade list, win rate, P&L, max drawdown."
          }
        }
      ]
    },
    {
      "name": "💰 Prices",
      "item": [
        {
          "name": "Get LTP (Index)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/prices/ltp/NIFTY",
              "host": ["{{base_url}}"],
              "path": ["prices", "ltp", "NIFTY"]
            },
            "description": "Fetch live last traded price for an index.\nSupported: NIFTY | BANKNIFTY | FINNIFTY | SENSEX\nRequires an active Upstox broker connection."
          }
        }
      ]
    },
    {
      "name": "🕯️ ORB Strategy",
      "item": [
        {
          "name": "ORB Chart Data",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/orb/chart-data?symbol=RELIANCE&timeframe=5min&from_date=2025-01-01&to_date=2025-03-31&limit=10000",
              "host": ["{{base_url}}"],
              "path": ["orb", "chart-data"],
              "query": [
                { "key": "symbol",    "value": "RELIANCE" },
                { "key": "timeframe", "value": "5min", "description": "1min|5min|15min|25min|daily|weekly" },
                { "key": "from_date", "value": "2025-01-01" },
                { "key": "to_date",   "value": "2025-03-31" },
                { "key": "limit",     "value": "10000" }
              ]
            },
            "description": "Fetch OHLCV candles directly from stock_data_<timeframe> for charting. Capped at limit (max 10000)."
          }
        },
        {
          "name": "ORB Signal (Live)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/orb/signal?symbols=RELIANCE,TCS&timeframe=5min",
              "host": ["{{base_url}}"],
              "path": ["orb", "signal"],
              "query": [
                { "key": "symbols",   "value": "RELIANCE,TCS", "description": "Comma-separated symbol list" },
                { "key": "timeframe", "value": "5min",         "description": "1min|5min|15min|30min|1h|eod" }
              ]
            },
            "description": "Return today's ORB signals for the requested symbols. Data is read from the DB — ensure intraday data has been imported first."
          }
        },
        {
          "name": "ORB Backtest",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"symbol\": \"RELIANCE\",\n  \"timeframe\": \"5min\",\n  \"from_date\": \"2025-01-01\",\n  \"to_date\": \"2025-03-31\",\n  \"qty\": 1,\n  \"or_candles\": 1,\n  \"market_open\": \"09:15\",\n  \"volume_multiplier\": 10.0,\n  \"volume_lookback\": 20,\n  \"direction\": \"both\",\n  \"risk_reward\": 1.0,\n  \"trailing_sl\": true,\n  \"trail_factor\": 1.0,\n  \"eod_exit\": true\n}"
            },
            "url": {
              "raw": "{{base_url}}/orb/backtest",
              "host": ["{{base_url}}"],
              "path": ["orb", "backtest"]
            },
            "description": "Run ORB backtest for a single symbol.\n\ndirection: both | long | short\nvolume_multiplier: 0.5 – 50 (×avg volume for breakout confirmation)\nor_candles: 1–10 (number of opening range candles)"
          }
        },
        {
          "name": "ORB Live / Paper Order",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"symbols\": [\"RELIANCE\", \"TCS\"],\n  \"timeframe\": \"5min\",\n  \"qty\": 1,\n  \"mode\": \"paper\",\n  \"confirm_live\": false\n}"
            },
            "url": {
              "raw": "{{base_url}}/orb/live",
              "host": ["{{base_url}}"],
              "path": ["orb", "live"]
            },
            "description": "Scan current ORB signals and place paper or live orders.\n\nLive trading requires:\n- ALLOW_LIVE_TRADING=true in .env\n- confirm_live: true in request body\n- Active Upstox broker connection"
          }
        },
        {
          "name": "ORB Available Stocks",
