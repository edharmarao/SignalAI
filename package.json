{
  "name": "signal-ai",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace apps/web",
    "build": "npm run build --workspace apps/web",
    "lint": "npm run lint --workspaces --if-present",
    "api": "cd apps/api && uvicorn app.main:app --reload --port ${API_PORT:-8003}"
  },
  "engines": {
    "node": ">=22.17.1"
  },
  "overrides": {
    "postcss": "^8.5.10",
    "next": {
      "postcss": "^8.5.10"
    }
  }
}
