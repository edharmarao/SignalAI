    {
      "name": "Strategies",
      "item": [
        {
          "name": "List Strategies",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/strategies"
          }
        },
        {
          "name": "Get Strategy by ID",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/strategies/:id",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "strategies",
                ":id"
              ],
              "variable": [
                {
                  "key": "id",
                  "value": "replace-with-strategy-id"
                }
              ]
            }
          }
        },
        {
          "name": "Create Indicator Strategy",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/strategies",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"EMA 9/21 Cross\",\n  \"type\": \"indicator\",\n  \"strategy_json\": {\n    \"symbol\": \"RELIANCE\",\n    \"symbols\": [\"RELIANCE\", \"TCS\"],\n    \"tf\": \"1D\",\n    \"action\": \"BUY\",\n    \"exitMode\": \"Both\",\n    \"sl\": \"2\",\n    \"tp\": \"4\",\n    \"tsl\": \"1\",\n    \"rawConditions\": [\n      {\n        \"id\": \"c1\",\n        \"lhs\": { \"kind\": \"EMA\", \"src\": \"close\", \"period\": 9 },\n        \"op\": \"crosses above\",\n        \"rhs\": { \"kind\": \"EMA\", \"src\": \"close\", \"period\": 21 }\n      }\n    ],\n    \"entry\": {\n      \"conditions\": [\n        {\n          \"lhs\": { \"kind\": \"EMA\", \"src\": \"close\", \"period\": 9 },\n          \"op\": \"crosses above\",\n          \"rhs\": { \"kind\": \"EMA\", \"src\": \"close\", \"period\": 21 }\n        }\n      ]\n    },\n    \"risk\": { \"maxLossPerDay\": 2000, \"maxTrades\": 5 }\n  }\n}"
            }
          }
        },
        {
          "name": "Delete Strategy",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{base_url}}/strategies/:id",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "strategies",
                ":id"
              ],
              "variable": [
                {
                  "key": "id",
                  "value": "replace-with-strategy-id"
                }
              ]
            }
          }
        }
      ]
    }
  ]
}