              ]
            },
            "description": "Create a strategy. Returns created strategy row including id, strategy_json, mode, status, created_at, updated_at.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"NIFTY ORB Strategy\",\n  \"strategy_json\": {\n    \"version\": 1,\n    \"name\": \"NIFTY ORB Strategy\",\n    \"desk\": \"equity\",\n    \"index\": \"NIFTY\",\n    \"symbol\": \"NIFTY\",\n    \"action\": \"BUY\",\n    \"candleTime\": \"5min\",\n    \"quantity\": 1,\n    \"mode\": \"paper\",\n    \"status\": \"draft\",\n    \"entry\": {\n      \"logic\": \"AND\",\n      \"conditions\": [\n        {\n          \"type\": \"level\",\n          \"field\": \"price\",\n          \"operator\": \">\",\n          \"value\": 22000\n        }\n      ]\n    },\n    \"exit\": {\n      \"logic\": \"OR\",\n      \"conditions\": [\n        {\n          \"type\": \"stop_loss\",\n          \"value\": 20\n        }\n      ]\n    },\n    \"risk\": {\n      \"maxLossPerDay\": 1000,\n      \"maxTradesPerDay\": 3,\n      \"maxOpenPositions\": 1,\n      \"autoSquareOffTime\": \"15:20\"\n    }\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "try {",
                  "  const data = pm.response.json();",
                  "  if (data && data.id) { pm.collectionVariables.set('strategy_id', data.id); }",
                  "} catch (e) {}"
                ]
              }
            }
          ]
        },
