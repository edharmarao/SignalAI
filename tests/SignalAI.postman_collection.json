            "url": {
              "raw": "{{base_url}}/backtest",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "backtest"
              ]
            },
            "description": "Run a strategy backtest. Actual request uses strategy_json plus optional candles/days; unknown helper fields are ignored. Returns totals and trades[].",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"symbol\": \"RELIANCE\",\n  \"from_date\": \"2025-01-01\",\n  \"to_date\": \"2025-03-31\",\n  \"strategy_json\": {\n    \"version\": 1,\n    \"name\": \"ORB Backtest Sample\",\n    \"desk\": \"equity\",\n    \"symbol\": \"RELIANCE\",\n    \"action\": \"BUY\",\n    \"candleTime\": \"5min\",\n    \"quantity\": 1,\n    \"mode\": \"paper\",\n    \"status\": \"draft\",\n    \"entry\": {\n      \"logic\": \"AND\",\n      \"conditions\": [\n        {\n          \"type\": \"orb_breakout\",\n          \"direction\": \"both\"\n        }\n      ]\n    },\n    \"exit\": {\n      \"logic\": \"OR\",\n      \"conditions\": [\n        {\n          \"type\": \"stop_loss\"\n        },\n        {\n          \"type\": \"target_rr\",\n          \"value\": 1.0\n        }\n      ]\n    },\n    \"risk\": {\n      \"maxLossPerDay\": 5000,\n      \"maxTradesPerDay\": 3,\n      \"maxOpenPositions\": 1,\n      \"killSwitch\": false\n    }\n  },\n  \"candles\": null,\n  \"days\": 30\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
